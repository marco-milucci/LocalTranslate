name: Build Portable Windows Executable

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-windows:
    runs-on: windows-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Unpack Project Zip
        shell: pwsh
        run: |
          if (Test-Path "LocalTranslate.zip") {
              Write-Host "Estrazione di LocalTranslate.zip in corso..."
              Expand-Archive -Path "LocalTranslate.zip" -DestinationPath "." -Force
              if (Test-Path "LocalTranslate\backend") {
                  Copy-Item -Recurse -Force "LocalTranslate\*" "."
              }
          }

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Dependencies
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements.txt pyinstaller pillow
          python -m pip install torch --index-url https://download.pytorch.org/whl/cpu

      - name: Download & Convert Model
        shell: pwsh
        run: |
          python -m backend.scripts.download_and_convert

      - name: Build Standalone Executable
        shell: python
        run: |
          import os
          import sys
          import shutil
          import pathlib
          import PyInstaller.__main__

          print("=== Inizio compilazione PyInstaller ===")
          root_dir = pathlib.Path(".").resolve()
          backend_dir = root_dir / "backend"
          dist_dir = root_dir / "dist"
          build_dir = root_dir / "build"
          portable_dir = dist_dir / "LocalTranslate-Portable"

          icon_path = root_dir / "assets" / "LocalTranslate.ico"
          icon_args = [f"--icon={icon_path}"] if icon_path.exists() else []

          pyinstaller_args = [
              "--name=LocalTranslate",
              "--onedir",
              "--noconsole",
              *icon_args,
              "--collect-all=ctranslate2",
              "--collect-all=transformers",
              "--collect-all=sentencepiece",
              "--collect-all=pystray",
              "--copy-metadata=ctranslate2",
              "--copy-metadata=transformers",
              "--copy-metadata=sentencepiece",
              "--hidden-import=uvicorn.logging",
              "--hidden-import=uvicorn.loops",
              "--hidden-import=uvicorn.loops.auto",
              "--hidden-import=uvicorn.protocols",
              "--hidden-import=uvicorn.protocols.http",
              "--hidden-import=uvicorn.protocols.http.auto",
              "--hidden-import=uvicorn.protocols.websockets",
              "--hidden-import=uvicorn.protocols.websockets.auto",
              "--hidden-import=uvicorn.lifespans",
              "--hidden-import=uvicorn.lifespans.on",
              "--hidden-import=pystray._win32",
              "--hidden-import=PIL",
              "--hidden-import=PIL.Image",
              "--exclude-module=torch",
              "--exclude-module=torchvision",
              "--exclude-module=torchaudio",
              "--exclude-module=matplotlib",
              "--exclude-module=scipy",
              f"--paths={root_dir}",
              f"--paths={backend_dir}",
              f"--distpath={dist_dir}",
              f"--workpath={build_dir}",
              str(backend_dir / "app" / "desktop" / "app_launcher.py"),
          ]

          print("Esecuzione PyInstaller...")
          PyInstaller.__main__.run(pyinstaller_args)

          output_exe_dir = dist_dir / "LocalTranslate"
          if not output_exe_dir.exists():
              raise RuntimeError(f"Cartella di output PyInstaller non trovata: {output_exe_dir}")

          print("=== Assemblaggio cartella portabile ===")
          if portable_dir.exists():
              shutil.rmtree(portable_dir)
          portable_dir.mkdir(parents=True, exist_ok=True)

          # 1. Copia i binari compilati
          for item in output_exe_dir.iterdir():
              dest = portable_dir / item.name
              if item.is_dir():
                  shutil.copytree(item, dest, dirs_exist_ok=True)
              else:
                  shutil.copy2(item, dest)

          # 2. Copia estensione browser
          ext_src = root_dir / "extension"
          if ext_src.exists():
              shutil.copytree(ext_src, portable_dir / "extension", dirs_exist_ok=True)

          # 3. Copia assets
          assets_src = root_dir / "assets"
          if assets_src.exists():
              shutil.copytree(assets_src, portable_dir / "assets", dirs_exist_ok=True)

          # 4. Copia modello int8 convertito
          models_src = backend_dir / "models"
          if models_src.exists():
              print("Integrazione modello INT8 nel pacchetto portabile...")
              shutil.copytree(models_src, portable_dir / "backend" / "models", dirs_exist_ok=True)
              shutil.copytree(models_src, portable_dir / "models", dirs_exist_ok=True)
              internal_backend = portable_dir / "_internal" / "backend"
              if internal_backend.exists():
                  shutil.copytree(models_src, internal_backend / "models", dirs_exist_ok=True)

          print("=== Creazione archivio ZIP finale ===")
          zip_base = str(dist_dir / "LocalTranslate-Portable-Windows")
          shutil.make_archive(zip_base, "zip", str(portable_dir))
          final_zip = dist_dir / "LocalTranslate-Portable-Windows.zip"
          print(f"Pacchetto ZIP completato con successo: {final_zip} (dimensione: {final_zip.stat().st_size} bytes)")

      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: LocalTranslate-Portable-Windows
          path: dist/LocalTranslate-Portable-Windows.zip
          retention-days: 30
